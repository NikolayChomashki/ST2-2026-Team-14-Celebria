@model RegisterViewModel
@{ ViewData["Title"] = "Регистрация"; }

<div class="auth-wrap">
    <div class="content-card auth-card p-4 p-lg-5">
        <div class="eyebrow">НОВ ПРОФИЛ</div>
        <h1 class="section-title mb-1">Регистрация</h1>
        <p class="text-muted mb-4">Създайте профил на организатор в Celebria.</p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" autocomplete="name" placeholder="Напр. Мария Иванова" autofocus />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" placeholder="напр. maria.ivanova" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">Поне 8 символа.</div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Създай профил</button>
        </form>

        <p class="text-center text-muted small mt-4 mb-0">
            Вече имате профил? <a class="muted-link" asp-action="Login">Влезте</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
