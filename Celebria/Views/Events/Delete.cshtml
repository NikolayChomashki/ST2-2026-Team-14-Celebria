@model Event
@inject EventTypeCatalog Types
@{ ViewData["Title"] = "Изтриване"; }

<div class="page-heading mb-4">
    <div class="eyebrow">ПОТВЪРЖДЕНИЕ</div>
    <h1>Изтриване на събитие</h1>
</div>
<div class="content-card form-card p-4 p-lg-5">
    <div class="alert alert-warning">Сигурни ли сте, че искате да изтриете това събитие? Действието не може да бъде отменено.</div>
    <h2 class="h4">@Model.Title</h2>
    <p class="text-muted">
        @Types.NameOf(Model.EventType) · @(Model.Date?.ToString("dd.MM.yyyy")) · @Model.ClientName
        @if (!string.IsNullOrWhiteSpace(Model.Location)) { <span>· @Model.Location</span> }
    </p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
        <button type="submit" class="btn btn-danger px-4">Да, изтрий</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Отказ</a>
    </form>
</div>
