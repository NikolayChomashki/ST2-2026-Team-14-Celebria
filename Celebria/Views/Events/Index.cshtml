@model EventIndexViewModel
@inject EventTypeCatalog Types
@{
    ViewData["Title"] = "Събития";
    var f = Model.Filter;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="page-title mb-0">Събития</h1>
        <p class="text-muted mb-0">
            Показани <strong>@Model.Events.Count</strong> от @Model.TotalCount
            @if (!f.IsEmpty) { <span>(с активен филтър)</span> }
        </p>
    </div>
    <a asp-action="Create" class="btn btn-celebria">+ Ново събитие</a>
</div>

@* Бързи филтри по тип – линкове, които сменят само параметъра type в адреса. *@
<div class="type-chips mb-3">
    <a asp-action="Index" class="chip @(string.IsNullOrEmpty(f.Type) ? "active" : "")">Всички</a>
    @foreach (var t in Types.All)
    {
        <a asp-action="Index" asp-route-type="@t.Code" class="chip @(string.Equals(f.Type, t.Code, StringComparison.OrdinalIgnoreCase) ? "active" : "")">@t.Icon @t.Name</a>
    }
</div>

@* Филтърът е GET форма: критериите остават в адреса и страницата може да се сподели/презареди. *@
<form method="get" asp-action="Index" class="card card-body shadow-sm mb-4 filter-card">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label for="search" class="form-label">Търсене</label>
            <input id="search" name="search" value="@f.Search" class="form-control" placeholder="Наименование, клиент или място" />
        </div>
        <div class="col-lg-2 col-md-6">
            <label for="type" class="form-label">Тип</label>
            <select id="type" name="type" class="form-select">
                <option value="">Всички</option>
                @foreach (var t in Types.All)
                {
                    <option value="@t.Code" selected="@(string.Equals(f.Type, t.Code, StringComparison.OrdinalIgnoreCase))">@t.Name</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label for="status" class="form-label">Статус</label>
            <select id="status" name="status" class="form-select">
                <option value="">Всички</option>
                @foreach (var s in Enum.GetValues<EventStatus>())
                {
                    <option value="@s" selected="@(f.Status == s)">@s.DisplayName()</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <label for="from" class="form-label">От дата</label>
            <input id="from" name="from" type="date" value="@(f.From?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <label for="to" class="form-label">До дата</label>
            <input id="to" name="to" type="date" value="@(f.To?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-celebria">Филтрирай</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="empty-state card card-body text-center text-muted">
        <p class="mb-2 fs-5">Няма събития, които да отговарят на филтъра.</p>
        <p class="mb-0"><a asp-action="Index">Покажи всички</a> или <a asp-action="Create">добави ново събитие</a>.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 events-table">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Събитие</th>
                        <th>Тип</th>
                        <th>Клиент</th>
                        <th class="text-end">Гости</th>
                        <th class="d-none d-lg-table-cell">Място</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.Events)
                    {
                        var type = Types.Find(ev.EventType);
                        var isPast = ev.Date < DateTime.Today;
                        <tr class="@(isPast ? "text-muted" : "")">
                            <td class="text-nowrap">@(ev.Date?.ToString("dd.MM.yyyy"))</td>
                            <td><a asp-action="Details" asp-route-id="@ev.Id" class="fw-semibold">@ev.Title</a></td>
                            <td class="text-nowrap">@(type?.Icon) @Types.NameOf(ev.EventType)</td>
                            <td>@ev.ClientName</td>
                            <td class="text-end">@ev.GuestCount</td>
                            <td class="d-none d-lg-table-cell">@ev.Location</td>
                            <td><span class="badge @ev.Status.BadgeClass()">@ev.Status.DisplayName()</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
