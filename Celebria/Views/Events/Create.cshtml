@model Event
@{ ViewData["Title"] = "Ново събитие"; }

<h1 class="page-title mb-3">Ново събитие</h1>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" novalidate>
            <partial name="_EventForm" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-celebria">Запис</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
