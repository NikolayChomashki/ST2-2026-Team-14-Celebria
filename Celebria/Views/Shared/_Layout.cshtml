<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Celebria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light container py-3">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">C</span>
                <span class="brand-stack"><strong>celebria</strong><small>CELEBRATE MOMENTS</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false" aria-label="Отвори менюто">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3 mt-3 mt-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Събития</a></li>
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Админ панел</a></li>
                        }
                        <li class="nav-item"><a class="btn btn-primary btn-sm px-3 rounded-pill" asp-controller="Events" asp-action="Create">+ Ново събитие</a></li>
                        <li class="nav-item d-flex align-items-center gap-2">
                            <span class="user-name">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Изход</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Вход</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm px-3 rounded-pill" asp-controller="Account" asp-action="Register">Регистрация</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main role="main" class="container page-content py-4 py-lg-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 py-3">
            <span>© 2026 Celebria · ST2 2026</span>
            <span>ASP.NET Core MVC · SQLite · Singleton</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
