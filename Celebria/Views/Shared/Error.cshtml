@model ErrorViewModel
@{
    ViewData["Title"] = "Възникна грешка";
}

<div class="content-card p-4 p-lg-5">
    <div class="eyebrow">CELEBRIA</div>
    <h1>Възникна неочаквана грешка</h1>
    <p class="text-muted">Моля, опитайте отново. Ако проблемът продължава, обърнете се към разработчиците на приложението.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Към събитията</a>
</div>
