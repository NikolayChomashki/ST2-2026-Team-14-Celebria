{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CelebriaDb": "Data Source=App_Data/celebria.db"
  },
  "ExternalApis": {
    // ВЪВЕДЕТЕ РЪЧНО СВОИТЕ КЛЮЧОВЕ МЕЖДУ КАВИЧКИТЕ. Не качвайте реални ключове в публично хранилище (GitHub)!

    // GOOGLE MAPS (по желание). Maps Embed API е безплатен, но иска ключ.
    // Как: https://console.cloud.google.com -> APIs & Services -> Library -> "Maps Embed API" -> Enable
    //      -> Credentials -> Create credentials -> API key. Ограничете го по HTTP referrer (напр. http://localhost:*/*).
    // Ако оставите празно, картата пак се показва (без ключ), но по неофициален начин.
    "GoogleMapsApiKey": "",

    // OPENWEATHER (задължително за времето).
    // Как: регистрация на https://openweathermap.org/api -> профил -> "My API keys" -> копирайте ключа.
    // Нов ключ се активира до ~2 часа след регистрацията (до тогава API връща 401).
    // По-добре: десен бутон на проекта -> Manage User Secrets и сложете ключа там.
    "OpenWeatherApiKey": "",

    // Код на държавата, който се добавя към града при търсене на времето (BG = България).
    "DefaultCountryCode": "BG"
  }
}
